# Optional. The app works with no .env file at all (SQLite database, generated secrets).
# Copy to .env only if you want to change these.

# Use PostgreSQL instead of the built-in SQLite database (also: pip install -r requirements-postgres.txt)
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/ecoserve

# SECRET_KEY=any-long-random-string
# JWT_SECRET_KEY=another-long-random-string
